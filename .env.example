# DeepSeek API 配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_ITERATIONS=3
DEFAULT_TEMPERATURE=0.7

# LLM 调用失败自动重试（网络错误 / 限流 429 / 服务端 5xx，指数退避）
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1.5

# 数据存储
DATA_DIR=./data
RESULTS_DIR=./data/results
UPLOADS_DIR=./data/uploads
# SQLite 数据库（留空则默认使用 DATA_DIR/app.db）
DATABASE_URL=

# RAG 检索增强（文献库向量化索引）
RAG_ENABLED=true
RAG_DIR=./data/rag
# HuggingFace 镜像（国内网络建议保留；可直连官方时改为 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=300
# 模型缓存目录（默认 data/rag/fastembed_cache，无需修改）
# FASTEMBED_CACHE_PATH=./data/rag/fastembed_cache
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=fastembed
# OpenAI 兼容 Embedding API（EMBEDDING_PROVIDER=openai 时使用）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
CHUNK_SIZE=600
CHUNK_OVERLAP=120
# 语义辅助切块：用段落 embedding 相似度优化段落合并决策（默认关闭，实验性）
#   语义突降（相似度 < RAG_SEMANTIC_MIN_SIM）时强制切分，语义相近（> RAG_SEMANTIC_MAX_SIM）允许超限合并
#   索引时会额外计算一次段落向量（复用 embedding 模型），模型加载失败自动回退为纯规则切块
RAG_SEMANTIC_CHUNKING=false
RAG_SEMANTIC_MIN_SIM=0.50
RAG_SEMANTIC_MAX_SIM=0.82
RAG_SEMANTIC_MAX_RATIO=1.30
RAG_TOP_K=8
RAG_RERANK_TOP_K=5
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_SECTION_BOOST=true
RAG_INDEX_CONCURRENCY=2
RAG_INDEX_MAX_RETRIES=2

# 工作流任务并发（无依赖冲突的子任务并行执行，如多学科审稿）
CREW_TASK_CONCURRENCY=3

# 学术检索（可选，可提高 Semantic Scholar 速率限制）
SEMANTIC_SCHOLAR_API_KEY=

# 用户认证
JWT_SECRET=change-me-in-production
ADMIN_PASSWORD=admin123
